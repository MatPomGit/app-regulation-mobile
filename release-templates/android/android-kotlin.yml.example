name: Validate native Android variants
on:
  workflow_dispatch:

concurrency:
  group: android-kotlin-${{ github.ref }}
  cancel-in-progress: true
jobs:
  build:
    if: ${{ github.ref == 'refs/heads/main' }}
    runs-on: ubuntu-latest
    timeout-minutes: 20
    permissions:
      contents: read
    steps:
      - uses: actions/checkout@v7
      - run: python3 scripts/generate_kotlin_session_graph.py --check
      - uses: actions/setup-java@v6
        with:
          distribution: temurin
          java-version: "17"
      - uses: gradle/actions/setup-gradle@v6
        with:
          gradle-version: "9.6.0"
          cache-provider: basic
      - name: Test core contract
        working-directory: android
        run: gradle :app:testCoreDebugUnitTest :app:lintCoreDebug --stacktrace
