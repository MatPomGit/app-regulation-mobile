name: Build Google Play internal-app-sharing release

on:
  workflow_dispatch:

permissions:
  contents: write

concurrency:
  group: android-google-play-test-release
  cancel-in-progress: true

jobs:
  build:
    if: ${{ github.ref == 'refs/heads/main' }}
    runs-on: ubuntu-latest
    timeout-minutes: 30
    steps:
      - name: Checkout
        uses: actions/checkout@v7

      - name: Setup Java
        uses: actions/setup-java@v6
        with:
          distribution: temurin
          java-version: "17"

      - name: Setup Gradle
        uses: gradle/actions/setup-gradle@v6
        with:
          gradle-version: "9.6.0"
          cache-provider: basic

      - name: Set version metadata
        shell: bash
        run: |
          set -euo pipefail
          echo "ARC_ADHD_VERSION_CODE=$((260200000 + GITHUB_RUN_NUMBER))" >> "$GITHUB_ENV"
          echo "ARC_ADHD_VERSION_NAME=0.1.0-playtest.${GITHUB_RUN_NUMBER}" >> "$GITHUB_ENV"

      - name: Build debug APK and AAB variants
        working-directory: android
        run: >-
          gradle
          :app:assembleCoreDebug
          :app:assembleFacialDebug
          :app:assembleBilateralDebug
          :app:assembleEmbodiedArDebug
          :app:assembleEegDebug
          :app:bundleCoreDebug
          :app:bundleFacialDebug
          :app:bundleBilateralDebug
          :app:bundleEmbodiedArDebug
          :app:bundleEegDebug
          --stacktrace

      - name: Collect Play test files
        shell: bash
        run: |
          set -euo pipefail
          mkdir -p dist

          for flavor in core facial bilateral embodiedAr eeg; do
            apk="$(find android/app/build/outputs/apk -type f -iname "*${flavor}*debug*.apk" | head -1)"
            aab="$(find android/app/build/outputs/bundle -type f -iname "*${flavor}*debug*.aab" | head -1)"
            [ -n "$apk" ] || { echo "::error::Missing APK for $flavor"; exit 3; }
            [ -n "$aab" ] || { echo "::error::Missing AAB for $flavor"; exit 3; }
            cp "$apk" "dist/arc-adhd-${flavor}-${ARC_ADHD_VERSION_NAME}.apk"
            cp "$aab" "dist/arc-adhd-${flavor}-${ARC_ADHD_VERSION_NAME}.aab"
          done

          cat > dist/PACKAGE_MAPPING.csv <<EOF
          variant,package_name
          core,pl.edu.prz.arcadhd.core
          facial,pl.edu.prz.arcadhd.facial
          bilateral,pl.edu.prz.arcadhd.bilateral
          embodiedAr,pl.edu.prz.arcadhd.ar
          eeg,pl.edu.prz.arcadhd.eeg
          EOF

          cat > dist/PLAY_CONSOLE_INSTRUCTION.txt <<EOF
          ARC-ADHD Google Play technical test package

          versionName: ${ARC_ADHD_VERSION_NAME}
          versionCode: ${ARC_ADHD_VERSION_CODE}
          git SHA: ${GITHUB_SHA}

          IMPORTANT:
          These are debug-signed artifacts for Google Play INTERNAL APP SHARING only.
          Do not use them to establish or replace the upload key for normal
          Internal testing, Closed testing, Open testing, or Production tracks.

          In each matching Play Console application open:
          Test and release > Setup > Internal app sharing

          Package mapping:
          core       -> pl.edu.prz.arcadhd.core
          facial     -> pl.edu.prz.arcadhd.facial
          bilateral  -> pl.edu.prz.arcadhd.bilateral
          embodiedAr -> pl.edu.prz.arcadhd.ar
          eeg        -> pl.edu.prz.arcadhd.eeg

          Upload the AAB or APK matching that package.
          participant_ready=false.
          EOF

          cat > dist/BUILD_INFO.txt <<EOF
          repository=${GITHUB_REPOSITORY}
          git_sha=${GITHUB_SHA}
          run_id=${GITHUB_RUN_ID}
          version_code=${ARC_ADHD_VERSION_CODE}
          version_name=${ARC_ADHD_VERSION_NAME}
          build_type=debug
          play_channel=internal-app-sharing
          participant_ready=false
          EOF

          (cd dist && sha256sum *.apk *.aab > SHA256SUMS.txt)
          ls -lh dist

      - name: Publish durable prerelease
        uses: softprops/action-gh-release@v3
        with:
          tag_name: android-play-share-v0.1.0-${{ github.run_number }}
          target_commitish: ${{ github.sha }}
          name: "ARC-ADHD Play internal sharing ${{ env.ARC_ADHD_VERSION_NAME }}"
          prerelease: true
          body: |
            Technical ARC-ADHD package for Google Play Internal App Sharing.
            Contains five AAB files, five APK files, package mapping, checksums and upload instructions.
            These debug-signed artifacts are not the upload-key release for normal testing or production tracks.
            participant_ready=false.
          files: |
            dist/*.aab
            dist/*.apk
            dist/*.txt
            dist/*.csv
